# ========================================
# Gallup Tool 环境变量配置模板
# ========================================
# 复制此文件为 .env.local 并填入实际值
# 命令: cp .env.local.example .env.local

# ========================================
# AI 服务配置（选择一个或多个）
# ========================================

# 方式 1: 使用 Anthropic Claude API（推荐）
# 获取地址: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 方式 2: 使用 OpenAI API（备用）
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# 方式 3: 使用智谱 GLM4 API（默认推荐）
# 获取地址: https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=your_zhipu_api_key_here

# ========================================
# 功能开关
# ========================================

# 启用 AI 生成（设置为 true 启用 AI，false 使用 Mock 数据）
ENABLE_AI=false

# 指定 AI 提供商（zhipu、anthropic 或 openai，默认为 zhipu）
# - zhipu: 智谱 GLM4（默认，用于报告解读）
# - anthropic: Anthropic Claude（用于突破方案生成）
# - openai: OpenAI GPT-4（备用）
AI_PROVIDER=zhipu

# ========================================
# AI 模型配置（可选）
# ========================================

# Claude 模型选择（默认 claude-3-5-sonnet-20241022）
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI 模型选择（默认 gpt-4o）
OPENAI_MODEL=gpt-4o

# 智谱模型选择（默认 glm-4-plus）
ZHIPU_MODEL=glm-4-plus

# ========================================
# 应用配置
# ========================================

# 应用环境（development, production）
NODE_ENV=development

# 应用 URL（用于分享链接等功能）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========================================
# OCR 服务配置（用于报告解读）
# ========================================

# Python PaddleOCR 服务地址
OCR_SERVICE_URL=http://localhost:5001
